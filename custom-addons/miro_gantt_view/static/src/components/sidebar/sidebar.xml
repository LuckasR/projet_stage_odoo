<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ==========================================================================
         GanttHeaderSidebar: renders the sidebar portion of the header (sticky left).
         Div-based CSS Grid: the name column + enabled info columns use the same
         `grid-template-columns` string (colsCss) as the sidebar body rows, so the
         column labels stay pixel-aligned with the row cells.
         Contains title and sort icon aligned with column headers.
         Rendered separately from GanttHeader and placed in grid-column: 1.
         Data: same as GanttHeader (sidebarVisible, defaultTitle, sidebarCols,
               colsCss, ...)
         ========================================================================== -->
    <t t-name="gantt_view.HeaderSidebar">
        <t t-if="sidebarVisible">
            <div class="o_gantt_view_header_sidebar"
                 t-attf-style="width: {{ sidebarWidth }}px;">
                <!-- Spacer aligned with major header row -->
                <div class="o_gantt_view_header_sidebar_major"></div>
                <!-- Header row with title, sort icon and column labels -->
                <div class="o_gantt_view_header_sidebar_minor"
                     t-attf-style="grid-template-columns: {{ colsCss }};">
                    <div class="o_gantt_view_sidebar_name">
                        <t t-if="defaultTitle">
                            <i class="fa fa-folder-open me-1"
                               style="font-size: 12px; color: #6c757d; flex-shrink: 0;"/>
                            <span class="o_gantt_view_header_title_clickable"
                                  style="font-size: 12px; cursor: pointer;"
                                  t-esc="defaultTitle"/>
                        </t>
                        <t t-if="sortOrder">
                            <span class="fa ms-1"
                                  style="font-size: 12px; opacity: 0.6;"
                                  t-att-class="sortOrder === 'asc' ? 'fa-angle-up' : 'fa-angle-down'"/>
                        </t>
                    </div>
                    <div t-foreach="sidebarCols" t-as="col"
                         t-key="col.key" t-if="col.key !== 'name'"
                         t-att-aria-label="col.label"
                         t-att-class="'o_gantt_view_sidebar_' + col.key + ' o_gantt_view_sidebar_info'">
                        <t t-esc="col.label"/>
                    </div>
                    <!-- Sidebar field toggler: `position: absolute` so it is
                         taken out of the grid flow (doesn't consume a
                         grid-template-columns cell) and stays visually on
                         the SAME line as the column headers, pinned to the
                         top-right corner. Fully manual open/close (see
                         attachHeaderEvents in components/header/header.js):
                         this header is rendered imperatively via
                         renderToElement, and Bootstrap's own
                         data-bs-toggle="dropdown" positions its menu with
                         `position: absolute` in normal flow, which gets
                         clipped by `.o_gantt_view_header_sidebar`'s
                         `overflow: hidden`. Manual `position: fixed`
                         (computed in JS) escapes that clipping. -->
                    <div t-if="sidebarToggleFields.length"
                         class="o_gantt_view_sidebar_fields_toggle">
                        <button type="button"
                                class="btn btn-sm btn-link o_gantt_view_sidebar_fields_toggle_btn"
                                t-att-title="sidebarToggleFieldsTitle">
                            <i class="fa fa-sliders"/>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end o_gantt_view_sidebar_fields_menu">
                            <t t-foreach="sidebarToggleFields" t-as="sf" t-key="sf.name">
                                <li>
                                    <button type="button"
                                            class="dropdown-item o_gantt_view_sidebar_field_item"
                                            t-att-data-field="sf.name">
                                        <i t-att-class="'fa me-1 ' + (sidebarFieldsState[sf.name] ? 'fa-check-square-o' : 'fa-square-o')"/>
                                        <t t-esc="sf.label"/>
                                    </button>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </t>
    </t>


    <!-- ==========================================================================
         GanttSidebarBody: renders the entire sidebar body as stacked CSS Grid
         rows (one <div> per row), sharing the sidebar columns' grid-template
         with the header (Gantt.HeaderSidebar). Rows are a flat list: groups
         (child groups are flattened into their own rows with an indented name
         cell), record bands (one row per band; each lane/taskbar is an
         absolutely positioned sub-row inside the name cell, mirrored per info
         column) and empty rows (no data, kept visible as a plain grid).
         Called via renderToElement() from renderer_dom.js.
         Data: { cols, colsCss, rows }
         ========================================================================== -->
    <t t-name="miro_gantt_view.Gantt.SidebarBody">
        <div class="o_gantt_view_row_headers bg-white">
            <t t-foreach="rows" t-as="row" t-key="row_index">
                <!-- Empty row (visible when there is no data) -->
                <t t-if="row.type === 'empty'">
                    <div class="o_gantt_view_sidebar_grid o_gantt_view_row_sidebar o_gantt_view_empty_row"
                         t-attf-style="height: {{ row.height }}px; grid-template-columns: {{ row.colsCss }};">
                    </div>
                </t>
                <!-- Group row (flattened child groups included) -->
                <t t-elif="row.type === 'group'">
                    <div class="o_gantt_view_sidebar_grid o_gantt_view_row_header o_gantt_view_row_sidebar o_gantt_view_group"
                         t-att-class="{'o_gantt_view_group_child': row.row.isChild, 'o_gantt_view_group_leaf': !row.row.isParent, 'o_gantt_view_group_drag_hover': row.dragHover}"
                         t-attf-style="height: {{ row.row.height }}px; grid-template-columns: {{ row.colsCss }};"
                         t-att-title="row.row.name"
                         t-att-data-group-path="row.row.groupPath"
                         t-att-data-group-key="row.row.groupKey">
                        <!-- Name cell: toggle, avatar, title, count -->
                        <div class="o_gantt_view_sidebar_name">
                            <div class="o_gantt_view_sidebar_name_outer">
                                <i class="fa pt-1 me-2 o_gantt_view_group_toggle"
                                   t-att-class="{'fa-play': row.row.isCollapsed, 'fa-sort-desc': !row.row.isCollapsed}"
                                   t-attf-style="cursor: pointer; margin-left: {{ row.row.indent }}px;"/>
                                <t t-if="row.row.hasAvatar">
                                    <t t-if="row.row.avatarUrl">
                                        <img t-att-src="row.row.avatarUrl"
                                             t-att-alt="row.row.name"
                                             style="width: 26px; height: 26px; border-radius: 10%; object-fit: cover; margin-right: 4px; flex-shrink: 0;"
                                             loading="lazy"
                                             class="o_gantt_view_group_avatar"/>
                                    </t>
                                    <t t-else="">
                                        <span class="o_gantt_view_group_avatar o_gantt_view_group_avatar_fallback"
                                              t-att-title="row.row.name"
                                              t-attf-style="width: 26px; height: 26px; border-radius: 10%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; color: #fff; margin-right: 4px; flex-shrink: 0; background-color: {{ row.row.avatarColor }};">
                                            <t t-esc="row.row.avatarInitials"/>
                                        </span>
                                    </t>
                                </t>
                                     <!-- t-att-class="{'fw-bold': !row.row.isChild}" -->
                                <div class="o_gantt_view_row_title text-truncate pe-1"
                                     style="min-width: 0;">
                                    <t t-esc="row.row.name"/>
<span class="text-muted ms-1" style="font-size: 12px;">
                                    (<t t-esc="row.row.visibleCount"/>)
                                </span>
                                </div>
                            </div>
                        </div>
                        <!-- Info columns (dynamic or historical fixed ones) -->
                        <div t-foreach="cols" t-as="col" t-key="col.key"
                             t-if="col.key !== 'name'"
                             t-att-class="'o_gantt_view_sidebar_' + col.key + ' o_gantt_view_sidebar_info'">
                            <t t-esc="row.row.cells[col.key]"/>
                        </div>
                    </div>
                </t>
                <!-- Record band row -->
                <t t-elif="row.type === 'band'">
                    <div class="o_gantt_view_sidebar_grid o_gantt_view_row_header o_gantt_view_row_sidebar"
                         t-att-style="row.row.rowStyle"
                         t-att-data-record-id="row.row.recordId"
                         t-att-data-record-ids="row.row.recordIds">
                        <!-- Name cell: one lane sub-row per taskbar (absolute) -->
                        <div class="o_gantt_view_sidebar_name">
                            <div class="o_gantt_view_band_lanes"
                                 t-attf-style="height: {{ row.row.bandHeight }}px;">
                                <t t-foreach="row.row.lanes.name" t-as="ln" t-key="ln.recordId">
                                    <div class="o_gantt_view_sidebar_taskrow"
                                         t-attf-style="{{ ln.subStyle }}">
                                        <span class="fa fa-file-o me-1"
                                              style="font-size: 10px; color: #6c757d; flex-shrink: 0;"/>
                                        <span class="o_gantt_view_row_title text-truncate ps-1 pe-1"
                                              t-att-title="ln.text"
                                              style="min-width: 0;"><t t-esc="ln.text"/></span>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <!-- Info columns (dynamic or historical fixed ones): one absolute
                             value per lane -->
                        <div t-foreach="cols" t-as="col" t-key="col.key"
                             t-if="col.key !== 'name'"
                             t-att-class="'o_gantt_view_sidebar_' + col.key + ' o_gantt_view_sidebar_info'">
                            <div class="o_gantt_view_band_lanes"
                                 t-attf-style="height: {{ row.row.bandHeight }}px;">
                                <t t-foreach="row.row.lanes[col.key]" t-as="lv" t-key="lv_index">
                                    <span class="o_gantt_view_lane_value"
                                          t-att-class="{'text-danger': lv.isOverProgress || lv.isUnderProgress || lv.isOverdue, 'text-muted': lv.isZero}"
                                          t-attf-style="top: {{ lv.top }}px; height: {{ lv.height }}px;">
                                        <t t-esc="lv.text"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>

</templates>
