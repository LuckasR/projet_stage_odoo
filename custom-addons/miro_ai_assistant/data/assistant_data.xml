<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Le bot : un contact et un utilisateur archivé (comme OdooBot).
             La messagerie n'ouvre une conversation qu'avec un contact qui a
             un utilisateur ; archivé, celui-ci ne peut pas se connecter. -->
        <record id="partner_miro_assistant" model="res.partner">
            <field name="name">Miro Assistant</field>
            <field name="email">assistant@miro-construction.local</field>
            <field name="image_1920" type="base64" file="miro_ai_assistant/static/img/assistant.png"/>
        </record>
        <record id="user_miro_assistant" model="res.users">
            <field name="login">miro_assistant</field>
            <field name="partner_id" ref="partner_miro_assistant"/>
            <field name="active" eval="False"/>
            <field name="groups_id" eval="[Command.set([ref('base.group_user')])]"/>
        </record>
    </data>
    <!-- Fournisseur par défaut (Groq, gpt-oss-20b) si rien n'est encore réglé -->
    <function model="miro.ai.assistant" name="_init_default_params"/>
</odoo>
