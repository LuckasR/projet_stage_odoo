<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_need_consume_wizard_form" model="ir.ui.view">
        <field name="name">construction.need.consume.wizard.form</field>
        <field name="model">construction.need.consume.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Quantités réellement mises en œuvre sur cette phase. Elles sortent du
                    stock vers « Consommation chantier » et alimentent l'écart réel / prévu.
                </p>
                <group>
                    <field name="task_id" readonly="1"/>
                    <field name="location_id"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="false">
                        <field name="need_id" column_invisible="1"/>
                        <field name="category_id"/>
                        <field name="product_id"/>
                        <field name="planned_qty"/>
                        <field name="consumed_qty"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Valider la consommation"
                        class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
