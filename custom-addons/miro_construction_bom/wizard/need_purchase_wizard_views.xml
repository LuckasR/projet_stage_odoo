<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_need_purchase_wizard_form" model="ir.ui.view">
        <field name="name">construction.need.purchase.wizard.form</field>
        <field name="model">construction.need.purchase.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Besoins « à commander » du projet, regroupés par produit. Une demande de
                    prix est créée par fournisseur ; les besoins y sont rattachés.
                </p>
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="deduct_stock"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="false">
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="need_ids" column_invisible="1"/>
                        <field name="needed_qty" force_save="1"/>
                        <field name="available_qty" force_save="1"/>
                        <field name="to_order_qty"/>
                        <field name="uom_id"/>
                        <field name="partner_id"/>
                        <field name="price_unit"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_create" type="object" string="Créer les demandes de prix"
                        class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
