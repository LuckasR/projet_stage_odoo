<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

        <!-- Exemple 1 : ajouter du texte après le bloc des informations
             (date de facture, échéance, origine...) -->
        <xpath expr="//div[@id='informations']" position="after">
            <div class="mon-info-perso">
                <span>Merci pour votre confiance !</span>
            </div>
        </xpath>

        <!-- Exemple 2 : remplacer complètement un bloc -->
        <xpath expr="//h2" position="replace">
            <h2>
                <span>Facture N°</span>
                <span t-if="o.name != '/'" t-field="o.name"/>
            </h2>
        </xpath>

        <!-- Exemple 3 : ajouter une classe CSS sur un élément existant -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class" add="ma-classe-tableau" separator=" "/>
        </xpath>

    </template>
</odoo>