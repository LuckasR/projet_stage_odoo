<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_miro_payslip_generate_form" model="ir.ui.view">
        <field name="name">miro.payslip.generate.form</field>
        <field name="model">miro.payslip.generate</field>
        <field name="arch" type="xml">
            <form string="Générer les bulletins de paie">
                <p class="text-muted">
                    Un bulletin par employé, calculé d'après ses présences de la période et
                    son mode de paie. Les employés ayant déjà un bulletin sur la période sont ignorés.
                </p>
                <group>
                    <group>
                        <label for="date_from" string="Période"/>
                        <div class="o_row">
                            <field name="date_from"/>
                            <i class="fa fa-long-arrow-right mx-2"/>
                            <field name="date_to"/>
                        </div>
                    </group>
                    <group>
                        <field name="pay_type"/>
                    </group>
                </group>
                <field name="employee_ids" widget="many2many_tags_avatar"/>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_miro_payslip_generate" model="ir.actions.act_window">
        <field name="name">Générer les bulletins</field>
        <field name="res_model">miro.payslip.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
