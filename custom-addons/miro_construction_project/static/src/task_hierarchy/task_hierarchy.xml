<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Toute la page défile : en-tête et synthèse remontent avec le
         contenu, rien n'est figé en haut de l'écran. -->
    <t t-name="miro_construction_project.TaskHierarchy" owl="1">
        <div class="o_ch">

            <!-- ═══════════════ EN-TÊTE ═══════════════ -->
            <header class="o_ch_header">
                <div class="o_ch_heading">
                    <span class="o_ch_eyebrow">
                        <i class="fa fa-sitemap"/>
                        <span>Diagramme des tâches</span>
                    </span>
                    <h1>
                        <a t-if="projectId" href="#" t-on-click.prevent="openProject"
                           t-esc="store.projectName || 'Projet sans titre'"/>
                        <t t-else="">Toutes les tâches</t>
                    </h1>
                    <div class="o_ch_subtitle">
                        <span><t t-esc="store.counts.ouvrages"/> ouvrages</span>
                        <span><t t-esc="store.counts.elements"/> éléments de construction</span>
                        <span><t t-esc="store.counts.phases"/> phases</span>
                    </div>
                </div>
                <div class="o_ch_header_actions" t-if="projectId">
                    <button class="o_ch_btn" t-on-click="openProject">
                        <i class="fa fa-folder-open-o"/><span>Fiche du chantier</span>
                    </button>
                    <button class="o_ch_btn o_ch_btn_primary" t-on-click="openViewer3D"
                            title="Maquette 3D construite à partir des éléments de construction">
                        <i class="fa fa-cube"/><span>Visualisation 3D</span>
                    </button>
                </div>
            </header>

            <!-- ═══════════════ SYNTHÈSE ═══════════════ -->
            <section class="o_ch_overview">
                <div class="o_ch_progress_card">
                    <svg class="o_ch_ring" viewBox="0 0 100 100">
                        <circle class="o_ch_ring_track" cx="50" cy="50" r="42"/>
                        <circle class="o_ch_ring_value" cx="50" cy="50" r="42"
                                t-att-stroke-dasharray="ringDash"/>
                    </svg>
                    <div class="o_ch_ring_label">
                        <span class="o_ch_ring_pct"><t t-esc="globalProgress"/>%</span>
                    </div>
                    <div class="o_ch_progress_text">
                        <span class="o_ch_progress_title">Avancement du chantier</span>
                        <span class="o_ch_progress_hint">
                            <strong><t t-esc="store.stats.done"/> / <t t-esc="store.stats.total"/></strong>
                            tâches terminées
                        </span>
                    </div>
                </div>

                <div class="o_ch_stats">
                    <t t-foreach="statusFilters" t-as="f" t-key="f.key">
                        <button t-attf-class="o_ch_stat is-{{ f.key }} {{ store.filter === f.key ? 'is-active' : '' }}"
                                t-on-click="() => this.setFilter(f.key)"
                                t-att-title="f.key === 'all' ? 'Afficher toutes les tâches' : 'Filtrer : ' + f.label">
                            <span class="o_ch_stat_icon"><i t-attf-class="fa {{ f.icon }}"/></span>
                            <span class="o_ch_stat_value" t-esc="statCount(f.key)"/>
                            <span class="o_ch_stat_label" t-esc="f.label"/>
                        </button>
                    </t>
                </div>
            </section>

            <!-- ═══════════════ ARBORESCENCE ═══════════════ -->
            <section class="o_ch_panel">
                <div class="o_ch_toolbar">
                    <div class="o_ch_search">
                        <i class="fa fa-search"/>
                        <input type="text" placeholder="Rechercher une tâche, un élément…"
                               t-att-value="store.search" t-on-input="onSearchInput"/>
                        <button t-if="store.search" class="o_ch_search_clear"
                                t-on-click="clearSearch" title="Effacer">
                            <i class="fa fa-times-circle"/>
                        </button>
                    </div>
                    <span t-if="store.filter !== 'all'" class="o_ch_active_filter">
                        Filtre : <t t-esc="statusFilters.find((f) => f.key === store.filter).label"/>
                        <button t-on-click="() => this.setFilter('all')" title="Retirer le filtre">
                            <i class="fa fa-times"/>
                        </button>
                    </span>
                    <div class="o_ch_segment">
                        <button t-on-click="collapseAll" title="Replier tout">
                            <i class="fa fa-compress"/> Replier
                        </button>
                        <button t-on-click="expandOuvrages" title="Afficher les éléments de chaque ouvrage">
                            <i class="fa fa-folder-open-o"/> Ouvrages
                        </button>
                        <button t-on-click="expandAll" title="Tout déplier, jusqu'aux phases">
                            <i class="fa fa-expand"/> Tout
                        </button>
                    </div>
                </div>

                <div t-if="store.loading" class="o_ch_loading">
                    <span class="o_ch_spinner"/>
                    <span>Chargement du diagramme…</span>
                </div>

                <t t-else="">
                    <div t-if="!visibleRootIds.length" class="o_ch_empty">
                        <i class="fa fa-folder-open-o"/>
                        <p t-if="store.search or store.filter !== 'all'">Aucune tâche ne correspond.</p>
                        <p t-else="">Aucune tâche enregistrée pour ce projet.</p>
                    </div>

                    <div t-else="" class="o_ch_table" role="table">
                        <div class="o_ch_thead" role="row">
                            <div class="o_ch_th o_ch_col_name" role="columnheader">Tâche</div>
                            <div class="o_ch_th o_ch_col_corps" role="columnheader">Type / corps de métier</div>
                            <div class="o_ch_th o_ch_col_date" role="columnheader">Échéance</div>
                            <div class="o_ch_th o_ch_col_status" role="columnheader">État</div>
                            <div class="o_ch_th o_ch_col_progress" role="columnheader">Avancement</div>
                        </div>
                        <div class="o_ch_tbody" role="rowgroup">
                            <ConstructionTaskNode
                                t-foreach="visibleRootIds" t-as="taskId" t-key="taskId"
                                store="store" taskId="taskId" depth="0"/>
                        </div>
                    </div>
                </t>
            </section>
        </div>
    </t>


    <t t-name="miro_construction_project.TaskNode" owl="1">
        <div class="o_construction_task_node" t-att-class="kindClass">
            <div class="o_construction_task_row" t-att-class="kindClass" t-on-click="openForm"
                 t-attf-style="--depth: #{props.depth};">

                <div class="o_ch_col_name o_ch_cell_name">
                    <span class="o_ch_indent" t-foreach="indents" t-as="i" t-key="i"/>
                    <button type="button" class="o_ch_toggle" t-att-class="{ 'is-leaf': !hasChildren }"
                            t-on-click.stop="toggle" tabindex="-1">
                        <i t-if="hasChildren" t-att-class="isExpanded ? 'fa fa-chevron-down' : 'fa fa-chevron-right'"/>
                    </button>
                    <span class="o_ch_kind" t-att-class="kindClass"><i t-attf-class="fa {{ kindIcon }}"/></span>
                    <div class="o_ch_name_block">
                        <span class="o_ch_task_name" t-esc="task.name"/>
                        <span t-if="isElement and task.dimension_summary" class="o_ch_task_meta"
                              t-esc="task.dimension_summary"/>
                    </div>
                    <span t-if="hasChildren" class="o_ch_count" t-esc="allChildIds.length"
                          t-att-title="allChildIds.length + ' sous-élément(s)'"/>
                    <span t-if="isElement and task.has_missing_fields" class="o_ch_badge_missing"
                          title="Caractéristiques obligatoires manquantes">incomplet</span>
                </div>

                <div class="o_ch_col_corps o_ch_cell_corps">
                    <span t-if="subtitle" t-esc="subtitle"/>
                    <span t-else="" class="o_ch_placeholder">—</span>
                </div>

                <div class="o_ch_col_date o_ch_cell_date" t-att-class="{ 'is-passed': deadlinePassed }">
                    <t t-if="deadline">
                        <i class="fa fa-calendar-o"/> <t t-esc="deadline"/>
                    </t>
                    <span t-else="" class="o_ch_placeholder">—</span>
                </div>

                <div class="o_ch_col_status">
                    <span class="o_ch_pill" t-att-class="status.cls" t-esc="status.label"/>
                </div>

                <div class="o_ch_col_progress o_ch_cell_progress">
                    <span class="o_ch_bar">
                        <span class="o_ch_bar_fill" t-att-class="status.cls"
                              t-attf-style="width: #{roundedProgress}%;"/>
                    </span>
                    <span class="o_ch_pct" t-esc="roundedProgress + '%'"/>
                </div>
            </div>

            <div t-if="isExpanded and childIds.length" class="o_construction_task_children">
                <ConstructionTaskNode
                    t-foreach="childIds" t-as="taskId" t-key="taskId"
                    store="props.store" taskId="taskId" depth="props.depth + 1"/>
            </div>
        </div>
    </t>

</templates>
