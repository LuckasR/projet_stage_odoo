<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Vue liste                                                      -->
    <!-- ============================================================= -->
    <record id="view_construction_wall_tree" model="ir.ui.view">
        <field name="name">construction.wall.tree</field>
        <field name="model">construction.wall</field>
        <field name="arch" type="xml">
            <tree string="Murs détectés" decoration-muted="not is_validated">
                <field name="name" />
                <field name="project_id" optional="show" />
                <field name="dwg_file_id" optional="hide" />
                <field name="level_id" optional="show" />
                <field name="wall_type" />
                <field name="orientation" optional="show" />
                <field name="layer" optional="hide" />
                <field name="length" sum="Longueur totale" />
                <field name="thickness" />
                <field name="height" />
                <field name="area" sum="Surface totale" optional="show" />
                <field name="volume" sum="Volume total" optional="hide" />
                <field name="source_view_ids" widget="many2many_tags" optional="show" />
                <field name="confidence" optional="show" />
                <field name="is_validated" />
            </tree>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Vue formulaire                                                 -->
    <!-- ============================================================= -->
    <record id="view_construction_wall_form" model="ir.ui.view">
        <field name="name">construction.wall.form</field>
        <field name="model">construction.wall</field>
        <field name="arch" type="xml">
            <form string="Mur détecté">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_element" type="object"
                            class="oe_stat_button" icon="fa-cube"
                            invisible="not element_id">
                            <span class="o_stat_text">Élément</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du mur" /></h1>
                    </div>

                    <group>
                        <group string="Rattachement">
                            <field name="project_id" readonly="1" />
                            <field name="dwg_file_id" readonly="1" />
                            <field name="level_id" />
                            <field name="match_key" readonly="1" />
                            <field name="element_id" readonly="1" />
                        </group>

                        <group string="Classification">
                            <field name="wall_type" />
                            <field name="material" />
                            <field name="orientation" />
                            <field name="layer" readonly="1" />
                        </group>
                    </group>

                    <group>
                        <group string="Dimensions">
                            <label for="length" />
                            <div><field name="length" class="oe_inline" /> m</div>
                            <label for="thickness" />
                            <div><field name="thickness" class="oe_inline" /> m</div>
                            <label for="height" />
                            <div>
                                <field name="height" class="oe_inline" /> m
                                <span class="text-muted" invisible="height">
                                    — non observée : importez une façade ou une coupe
                                    de ce niveau
                                </span>
                            </div>
                        </group>

                        <group string="Métrés">
                            <field name="area" />
                            <field name="volume" />
                        </group>
                    </group>

                    <group string="Traçabilité de la détection">
                        <group>
                            <field name="source_view_ids" widget="many2many_tags" />
                            <field name="source_file_ids" widget="many2many_tags" />
                        </group>
                        <group>
                            <field name="detection_method" />
                            <field name="confidence" />
                            <field name="is_validated" />
                        </group>
                    </group>

                    <group string="Géométrie" name="geometry">
                        <group>
                            <field name="geometry_type" />
                            <field name="start_x" />
                            <field name="start_y" />
                        </group>
                        <group>
                            <field name="center_x" />
                            <field name="end_x" />
                            <field name="end_y" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Vue recherche                                                  -->
    <!-- ============================================================= -->
    <record id="view_construction_wall_search" model="ir.ui.view">
        <field name="name">construction.wall.search</field>
        <field name="model">construction.wall</field>
        <field name="arch" type="xml">
            <search string="Rechercher un mur">
                <field name="name" />
                <field name="project_id" />
                <field name="dwg_file_id" />
                <field name="level_id" />
                <field name="layer" />

                <filter name="filter_exterior" string="Murs extérieurs"
                    domain="[('wall_type', '=', 'exterior')]" />
                <filter name="filter_interior" string="Murs intérieurs"
                    domain="[('wall_type', '=', 'interior')]" />

                <separator />

                <!-- Le cas d'usage central : ces murs attendent une vue en
                     façade ou en coupe du même niveau pour être complétés. -->
                <filter name="filter_no_height" string="Hauteur manquante"
                    domain="[('height', '=', 0)]" />
                <filter name="filter_no_thickness" string="Épaisseur manquante"
                    domain="[('thickness', '=', 0)]" />
                <filter name="filter_validated" string="Validés"
                    domain="[('is_validated', '=', True)]" />

                <separator />

                <filter name="group_project" string="Projet"
                    context="{'group_by': 'project_id'}" />
                <filter name="group_level" string="Niveau"
                    context="{'group_by': 'level_id'}" />
                <filter name="group_type" string="Type de mur"
                    context="{'group_by': 'wall_type'}" />
                <filter name="group_orientation" string="Orientation"
                    context="{'group_by': 'orientation'}" />
                <filter name="group_file" string="Plan d'origine"
                    context="{'group_by': 'dwg_file_id'}" />
            </search>
        </field>
    </record>

    <record id="action_construction_wall" model="ir.actions.act_window">
        <field name="name">Murs détectés</field>
        <field name="res_model">construction.wall</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_construction_wall_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun mur détecté pour l'instant</p>
            <p>
                Les murs sont détectés à l'import d'un plan dont le type est
                « Plan architectural ». Ils n'apparaissent pas dans les analyses
                de plan ni dans les éléments à valider : ce sont deux circuits
                distincts.
            </p>
        </field>
    </record>

    <menuitem id="menu_construction_wall" name="Murs détectés"
        parent="menu_construction_root" action="action_construction_wall" sequence="65" />

</odoo>
