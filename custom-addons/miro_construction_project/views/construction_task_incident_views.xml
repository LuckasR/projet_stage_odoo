<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_task_incident_list" model="ir.ui.view">
        <field name="name">construction.task.incident.tree</field>
        <field name="model">construction.task.incident</field>
        <field name="arch" type="xml">
            <tree decoration-danger="gravite == 'critique'"
                  decoration-warning="gravite == 'haute'">
                <field name="name"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="date_incident"/>
                <field name="gravite"/>
                <field name="etat" widget="badge"
                       decoration-success="etat == 'resolu'"/>
                <field name="responsable_id"/>
            </tree>
        </field>
    </record>

    <record id="view_construction_task_incident_form" model="ir.ui.view">
        <field name="name">construction.task.incident.form</field>
        <field name="model">construction.task.incident</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="task_id"/>
                        <field name="date_incident"/>
                        <field name="gravite"/>
                        <field name="etat"/>
                        <field name="responsable_id"/>
                    </group>
                    <field name="description" placeholder="Détails de l'incident..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_task_incident" model="ir.actions.act_window">
        <field name="name">Incidents de chantier</field>
        <field name="res_model">construction.task.incident</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
