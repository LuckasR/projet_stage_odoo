<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire tâche : ajout des infos chantier + accès au diagramme -->
    <record id="view_project_task_form_construction" model="ir.ui.view">
        <field name="name">project.task.form.construction</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_hierarchy_from_task" type="object"
                        class="oe_stat_button" icon="fa-sitemap">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Voir le</span>
                        <span class="o_stat_text">diagramme</span>
                    </div>
                </button>
                <button name="action_view_children_tasks" type="object"
                        class="oe_stat_button" icon="fa-sitemap"
                        invisible="not x_sous_taches_count_total">
                    <field name="x_sous_taches_count_total" widget="statinfo" string="Sous-tâches"/>
                </button>
                <button name="action_open_incidents" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle">
                    <field name="x_incident_count" widget="statinfo" string="Incidents"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="x_niveau_hierarchie"/>
            </xpath>

            <!-- Phase d'un élément : l'élément, ses cotes et ses métrés, en
                 tête de fiche (avant les onglets) -->
            <xpath expr="//notebook" position="before">
                <field name="construction_element_id" invisible="1"/>
                <div class="o_miro_phase_element" invisible="not construction_element_id">
                    <div class="o_miro_phase_element_head">
                        <span class="o_miro_phase_element_label">Élément de construction</span>
                        <field name="construction_element_id" readonly="1" nolabel="1"
                               options="{'no_create': True}" class="o_miro_phase_element_link"/>
                        <span class="text-muted">
                            <field name="element_type_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                            <span invisible="not element_level_id"> · </span>
                            <field name="element_level_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                        </span>
                    </div>
                    <div class="text-muted small mb-2" invisible="not element_dimension_summary">
                        <field name="element_dimension_summary" readonly="1" nolabel="1"/>
                    </div>
                    <div class="o_miro_phase_qty_grid">
                        <div class="o_miro_phase_qty is-main" invisible="not phase_qty_label">
                            <span class="o_miro_phase_qty_label">Quantité de la phase</span>
                            <span class="o_miro_phase_qty_value">
                                <field name="phase_qty" readonly="1" nolabel="1"/>
                            </span>
                            <span class="o_miro_phase_qty_unit"><field name="phase_qty_label" readonly="1" nolabel="1"/></span>
                        </div>
                        <div class="o_miro_phase_qty" invisible="not element_qty_beton_m3">
                            <span class="o_miro_phase_qty_label">Volume béton</span>
                            <span class="o_miro_phase_qty_value"><field name="element_qty_beton_m3" readonly="1" nolabel="1"/> m³</span>
                        </div>
                        <div class="o_miro_phase_qty" invisible="not element_qty_coffrage_m2">
                            <span class="o_miro_phase_qty_label">Surface coffrée</span>
                            <span class="o_miro_phase_qty_value"><field name="element_qty_coffrage_m2" readonly="1" nolabel="1"/> m²</span>
                        </div>
                        <div class="o_miro_phase_qty" invisible="not element_qty_surface_m2">
                            <span class="o_miro_phase_qty_label">Surface</span>
                            <span class="o_miro_phase_qty_value"><field name="element_qty_surface_m2" readonly="1" nolabel="1"/> m²</span>
                        </div>
                        <div class="o_miro_phase_qty" invisible="not element_qty_acier_kg">
                            <span class="o_miro_phase_qty_label">Acier</span>
                            <span class="o_miro_phase_qty_value"><field name="element_qty_acier_kg" readonly="1" nolabel="1"/> kg</span>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Avant la description : sur une tâche de chantier, c'est le
                 suivi qu'on vient consulter (les matériaux de la phase, s'il y
                 en a, se placent devant, cf. miro_construction_bom). -->
            <xpath expr="//page[@name='description_page']" position="before">
                <page string="Suivi de chantier" name="construction_suivi">
                    <group>
                        <group string="Organisation">
                            <field name="x_corps_metier"/>
                            <field name="x_responsable_technique_id"/>
                            <field name="x_niveau_priorite_chantier"/>
                        </group>
                        <group string="Planning">
                            <field name="x_date_debut_prevue"/>
                            <field name="x_date_fin_prevue"/>
                            <field name="x_duree_prevue_jours"/>
                            <field name="x_est_en_retard"/>
                        </group>
                    </group>
                    <group>
                        <group string="Avancement">
                            <!-- progressbar est en lecture seule sans « editable » :
                                 un clic sur la barre permet alors de saisir le %. -->
                            <field name="x_avancement_manuel" widget="progressbar"
                                   options="{'editable': true}"
                                   invisible="child_ids"/>
                            <field name="x_avancement_global" widget="progressbar"
                                   readonly="1"/>
                        </group>
                        <group string="Coûts">
                            <field name="x_cout_prevue"/>
                            <field name="x_cout_reel"/>
                        </group>
                    </group>
                    <group string="Incidents / problèmes rencontrés">
                        <field name="x_incident_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="date_incident"/>
                                <field name="gravite" widget="badge"
                                       decoration-danger="gravite == 'critique'"
                                       decoration-warning="gravite == 'haute'"/>
                                <field name="etat" widget="badge"
                                       decoration-success="etat == 'resolu'"/>
                                <field name="responsable_id"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Liste plate de toutes les tâches / sous-tâches d'un projet -->
    <record id="view_project_task_list_construction" model="ir.ui.view">
        <field name="name">project.task.list.construction</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <tree string="Tâches"
                  decoration-danger="x_est_en_retard"
                  decoration-muted="x_avancement_global == 100">
                <field name="x_niveau_hierarchie" optional="hide"/>
                <field name="name"/>
                <field name="parent_id" optional="show"/>
                <field name="stage_id"/>
                <field name="x_corps_metier" optional="show"/>
                <field name="x_responsable_technique_id" optional="show"/>
                <field name="date_deadline"/>
                <field name="x_est_en_retard" invisible="1"/>
                <field name="x_cout_prevue" optional="hide" sum="Total"/>
                <field name="x_cout_reel" optional="hide" sum="Total"/>
                <field name="x_avancement_global" widget="progressbar"/>
            </tree>
        </field>
    </record>

    
    
    
    <record id="project_task_miro_gantt_view_main_base" model="ir.ui.view">
        <field name="name">project.task.view.miro_gantt.main.base</field>
        <field name="model">project.task</field>
        <field name="type">miro_gantt</field>
        <field name="groups_id" eval="[(4, ref('miro_gantt_view.group_gantt_user'))]"/>
        <field name="arch" type="xml">
            <miro_gantt
            string="Task"
            default_title="Task"
            default_filter="month"
            default_group_by="project_id,user_ids"
            sidebar_column_fields="x_avancement_global,state,x_date_debut_prevue,x_date_fin_prevue,date_deadline"
            sidebar_label_field="name"
            taskbar_label_field="summary"
            date_start="x_date_debut_prevue"
            date_end="x_date_fin_prevue"
            duration_field="allocated_hours"
            status_field="state"
            progress_field="x_avancement_global"
            colored_by="project_id"
            available_filters="day,week,month,year"
            create_groups="miro_gantt_view.group_gantt_manager"
            edit_groups="miro_gantt_view.group_gantt_manager"
            delete_groups="miro_gantt_view.group_gantt_manager"
            >
            <field name="name"/>
            <field name="project_id"/>
            <field name="state"/>
            <field name="effective_hours"/>
            <field name="allocated_hours"/>
            <field name="x_avancement_global"/>
            <field name="description"/>
                <field name="summary"/>
                <field name="user_ids"/>
               
                <templates>
                    <t t-name="miro-gantt-popup">
                        <div class="o_miro_gantt_popup p-3">
                            <!-- Title -->

                            <!-- Project -->
                            <div t-if="project_id" >
                                <span class="fw-bold">Project:</span>
                                    <div class="text-muted"><t t-esc="project_id[1]"/></div>
                                </div>
                                <div>
                                    <span class="fw-bold">Summary :</span>
                                    <div class="text-muted"> <t t-esc="summary"/> </div>
                                </div>
                                
                                <!-- Dates -->
                                <div t-if="x_date_debut_prevue &amp;&amp; x_date_fin_prevue">
                                    <span class="fw-bold">Schedule:</span>
                                    <div class="text-muted">
                                                <i class="fa fa-calendar me-1" title="Schedule"/>
                                                <t t-esc="x_date_debut_prevue.toFormat('dd/MM/yyyy')"/>
                                                →
                                                <t t-esc="x_date_fin_prevue.toFormat('dd/MM/yyyy')"/>
                                            </div>
                                    </div>

                                    

                                    <div t-if="user_ids.length > 0" >
                                    <span class="fw-bold">Assigned to:</span>
                                    <div class="text-muted">
                                        <i class="fa fa-users me-1" title="Users"/>
                                        <t t-foreach="user_ids" t-as="user">
                                            <span>
                                                <t t-esc="user.name"/>
                                            </span>
                                            <t t-if="user_index != len(user_ids) - 1">, </t>
                                        </t>
                                    </div>
                                </div>
                              
                                
                                <!-- Duration -->
                                
                                <div t-if="allocated_hours">
                                    <span class="fw-bold">Duration:</span>
                                    <div class="text-muted">
                                        <i class="fa fa-hourglass-end me-1" title="Duration"/>
                                        <t t-esc="effective_hours.toFixed(2)"/>
                                        /
                                        <t t-esc="allocated_hours"/>
                                        hours
                                        
                                        <t t-if="effective_hours &gt; allocated_hours">
                                            <span class="text-danger fw-bold ms-2">
                                                (Time Variance: : <t t-esc="(allocated_hours - effective_hours).toFixed(2)"/>h)
                                            </span>
                                        </t>
                                    </div>
                                    <div class="x_avancement_global mt-2" style="height: 20px; width:100%;">
                                        <div class="x_avancement_global-bar fw-bold" role="progressbar"
                                        t-attf-style="width: #{(effective_hours / allocated_hours) * 100}%;"
                                        aria-valuemin="0" aria-valuemax="100">
                                        <!-- <t t-if="effective_hours &lt; allocated_hours"> -->
                                            <t t-esc="round((effective_hours / allocated_hours) * 100)"/>%
                                            <!-- </t> -->
                                            <!-- <t t-if="effective_hours &gt;= allocated_hours">
                                                <t t-esc="100"/>%
                                                </t> -->
                                            </div>
                                        </div>
                                </div>
                                
                                
                            </div>
                        </t>
                    </templates>
                </miro_gantt>
            </field>
        </record>
        
        <record id="action_project_task_list_construction" model="ir.actions.act_window">
            <field name="name">Tâches du projet</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">tree,form,miro_gantt</field>
            <field name="view_id" ref="view_project_task_list_construction"/>
        </record>
        
    </odoo>
    