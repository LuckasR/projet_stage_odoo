<?xml version="1.0" encoding="utf-8"?>
<!-- Conventions de calques livrées : « All » (réunit toutes les conventions,
     convention par défaut des chantiers) et la convention Miro, qui reprend
     les noms que les moteurs cherchaient jusqu'ici. noupdate : les noms
     ajoutés ou retirés par l'utilisateur ne sont jamais écrasés. -->
<odoo noupdate="1">
    <record id="dxf_layer_convention_all" model="construction.dxf.layer.convention">
        <field name="name">All</field>
        <field name="sequence">0</field>
        <field name="is_all" eval="True"/>
        <field name="note">Réunit les noms de calque de toutes les conventions.</field>
    </record>

    <record id="dxf_layer_convention_miro" model="construction.dxf.layer.convention">
        <field name="name">Convention Miro</field>
        <field name="sequence">10</field>
        <field name="note">Noms de calque des plans Miro Construction (A- architecture, S- structure).</field>
    </record>

