<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Gabarit de démonstration : Semelle (Ferraillage -> Coffrage -> Coulage) -->
    <record id="phase_template_semelle" model="construction.phase.template">
        <field name="name">Semelle</field>
    </record>
    <record id="phase_line_semelle_ferraillage" model="construction.phase.template.line">
        <field name="template_id" ref="phase_template_semelle"/>
        <field name="sequence">10</field>
        <field name="name">Ferraillage</field>
        <field name="phase_type">ferraillage</field>
        <field name="qty_key">acier_kg</field>
        <field name="rate_per_hour">25</field>
    </record>
    <record id="phase_line_semelle_coffrage" model="construction.phase.template.line">
        <field name="template_id" ref="phase_template_semelle"/>
        <field name="sequence">20</field>
        <field name="name">Coffrage</field>
        <field name="phase_type">coffrage</field>
        <field name="qty_key">coffrage_m2</field>
        <field name="rate_per_hour">4</field>
        <field name="depends_on_line_id" ref="phase_line_semelle_ferraillage"/>
    </record>
    <record id="phase_line_semelle_coulage" model="construction.phase.template.line">
        <field name="template_id" ref="phase_template_semelle"/>
        <field name="sequence">30</field>
        <field name="name">Coulage béton</field>
        <field name="phase_type">coulage</field>
        <field name="qty_key">beton_m3</field>
        <field name="rate_per_hour">1.5</field>
        <field name="depends_on_line_id" ref="phase_line_semelle_coffrage"/>
    </record>

    <!-- Gabarit de démonstration : Poteau. Mêmes phases que la semelle, mais
         des rendements plus faibles : un coffrage vertical se pose plus
         lentement qu'un coffrage de semelle, et le ferraillage d'un poteau
         (cadres, recouvrements) est plus long à mettre en place. -->
    <record id="phase_template_poteau" model="construction.phase.template">
        <field name="name">Poteau</field>
    </record>
    <record id="phase_line_poteau_ferraillage" model="construction.phase.template.line">
        <field name="template_id" ref="phase_template_poteau"/>
        <field name="sequence">10</field>
        <field name="name">Ferraillage</field>
        <field name="phase_type">ferraillage</field>
        <field name="qty_key">acier_kg</field>
        <field name="rate_per_hour">20</field>
    </record>
    <record id="phase_line_poteau_coffrage" model="construction.phase.template.line">
        <field name="template_id" ref="phase_template_poteau"/>
        <field name="sequence">20</field>
        <field name="name">Coffrage</field>
        <field name="phase_type">coffrage</field>
        <field name="qty_key">coffrage_m2</field>
        <field name="rate_per_hour">3</field>
        <field name="depends_on_line_id" ref="phase_line_poteau_ferraillage"/>
    </record>
    <record id="phase_line_poteau_coulage" model="construction.phase.template.line">
        <field name="template_id" ref="phase_template_poteau"/>
        <field name="sequence">30</field>
        <field name="name">Coulage béton</field>
        <field name="phase_type">coulage</field>
        <field name="qty_key">beton_m3</field>
        <field name="rate_per_hour">1</field>
        <field name="depends_on_line_id" ref="phase_line_poteau_coffrage"/>
    </record>

    <!-- Types produits par l'analyse « Fondations » (géométrie des calques
         S-SEM, S-POT, S-SEM-FIL et S-LON). Sans eux, les brouillons seraient
         créés avec un type inconnu et ne pourraient pas générer de phases.

         PAS de mot-clé DXF : ces ouvrages sont reconnus par leur géométrie,
         jamais par un bloc. Un mot-clé les rendrait éligibles au moteur
         « blocs », qui les chercherait en vain parmi les INSERT du plan et
         échouerait avec « Aucun bloc du plan ne correspond... ». Si vos
         semelles sont réellement dessinées comme des blocs DXF, remettez le
         mot-clé depuis Configuration > Types d'éléments. -->
    <record id="element_type_semelle" model="construction.element.type">
        <field name="name">Semelle</field>
        <field name="code">semelle</field>
        <field name="work_name">Fondation</field>
        <field name="phase_template_id" ref="phase_template_semelle"/>
        <field name="steel_ratio_kg_m3">80</field>
    </record>

    <record id="element_type_poteau" model="construction.element.type">
        <field name="name">Poteau</field>
        <field name="code">poteau</field>
        <field name="work_name">Structure</field>
        <field name="phase_template_id" ref="phase_template_poteau"/>
        <field name="ouvrage_per_level" eval="True"/>
        <field name="steel_ratio_kg_m3">120</field>
    </record>

    <record id="element_type_semelle_filante" model="construction.element.type">
        <field name="name">Semelle filante</field>
        <field name="code">semelle_filante</field>
        <field name="work_name">Fondation</field>
        <field name="phase_template_id" ref="phase_template_semelle"/>
        <field name="steel_ratio_kg_m3">80</field>
    </record>

    <record id="element_type_longrine" model="construction.element.type">
        <field name="name">Longrine</field>
        <field name="code">longrine</field>
        <field name="work_name">Fondation</field>
        <field name="phase_template_id" ref="phase_template_semelle"/>
        <field name="steel_ratio_kg_m3">100</field>
    </record>

    <!-- Caractéristiques attendues de chaque ouvrage.

         La HAUTEUR porte une valeur par défaut parce qu'une vue en plan ne la
         montre jamais : elle est fixée par la nomenclature du projet, pas
         relevée sur le dessin. Les valeurs livrées (0.30 m) sont celles d'un
         ouvrage courant — à ajuster par projet dans Configuration.

         Longueur et largeur n'ont PAS de valeur par défaut : elles sont bien
         lisibles sur le plan, et en inventer une masquerait une détection
         ratée. -->
    <record id="field_semelle_l" model="construction.element.type.field">
        <field name="type_id" ref="element_type_semelle"/>
        <field name="sequence">10</field>
        <field name="name">Longueur</field>
        <field name="code">l</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_semelle_w" model="construction.element.type.field">
        <field name="type_id" ref="element_type_semelle"/>
        <field name="sequence">20</field>
        <field name="name">Largeur</field>
        <field name="code">w</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_semelle_h" model="construction.element.type.field">
        <field name="type_id" ref="element_type_semelle"/>
        <field name="sequence">30</field>
        <field name="name">Hauteur</field>
        <field name="code">h</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
        <field name="default_value">0.00</field>
    </record>

    <record id="field_poteau_l" model="construction.element.type.field">
        <field name="type_id" ref="element_type_poteau"/>
        <field name="sequence">10</field>
        <field name="name">Côté X</field>
        <field name="code">l</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_poteau_w" model="construction.element.type.field">
        <field name="type_id" ref="element_type_poteau"/>
        <field name="sequence">20</field>
        <field name="name">Côté Y</field>
        <field name="code">w</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <!-- Hauteur d'un poteau : elle se lit sur une coupe ou une façade, pas sur
         le plan de fondation, où seule l'amorce est dessinée. -->
    <record id="field_poteau_h" model="construction.element.type.field">
        <field name="type_id" ref="element_type_poteau"/>
        <field name="sequence">30</field>
        <field name="name">Hauteur</field>
        <field name="code">h</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
        <field name="default_value">0.00</field>
    </record>

    <record id="field_semelle_filante_l" model="construction.element.type.field">
        <field name="type_id" ref="element_type_semelle_filante"/>
        <field name="sequence">10</field>
        <field name="name">Longueur</field>
        <field name="code">l</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_semelle_filante_w" model="construction.element.type.field">
        <field name="type_id" ref="element_type_semelle_filante"/>
        <field name="sequence">20</field>
        <field name="name">Largeur</field>
        <field name="code">w</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_semelle_filante_h" model="construction.element.type.field">
        <field name="type_id" ref="element_type_semelle_filante"/>
        <field name="sequence">30</field>
        <field name="name">Hauteur</field>
        <field name="code">h</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
        <field name="default_value">0.00</field>
    </record>

    <record id="field_longrine_l" model="construction.element.type.field">
        <field name="type_id" ref="element_type_longrine"/>
        <field name="sequence">10</field>
        <field name="name">Longueur</field>
        <field name="code">l</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_longrine_w" model="construction.element.type.field">
        <field name="type_id" ref="element_type_longrine"/>
        <field name="sequence">20</field>
        <field name="name">Largeur</field>
        <field name="code">w</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
        <field name="default_value">0.00</field>
    </record>
    <record id="field_longrine_h" model="construction.element.type.field">
        <field name="type_id" ref="element_type_longrine"/>
        <field name="sequence">30</field>
        <field name="name">Hauteur</field>
        <field name="code">h</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
        <field name="default_value">0.00</field>
    </record>

    <!-- Type produit par l'analyse « Murs détectés ». Un ouvrage par niveau :
         les murs du RDC et ceux du R+1 ne se suivent pas ensemble.
         Pas de gabarit de phases : à vous de le choisir dans Configuration,
         le découpage d'un mur dépend trop du mode constructif pour être
         supposé ici. -->
    <record id="element_type_mur" model="construction.element.type">
        <field name="name">Mur</field>
        <field name="code">mur</field>
        <field name="work_name">Maçonnerie</field>
        <field name="ouvrage_per_level" eval="True"/>
    </record>
    <!-- Mur : le moteur « murs » nomme l'épaisseur « ep ». Pas de valeur par
         défaut sur la hauteur : elle vient d'une façade ou d'une coupe
         validée, qui la renseigne pour tout le niveau. -->
    <record id="field_mur_l" model="construction.element.type.field">
        <field name="type_id" ref="element_type_mur"/>
        <field name="sequence">10</field>
        <field name="name">Longueur</field>
        <field name="code">l</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_mur_ep" model="construction.element.type.field">
        <field name="type_id" ref="element_type_mur"/>
        <field name="sequence">20</field>
        <field name="name">Épaisseur</field>
        <field name="code">ep</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_mur_h" model="construction.element.type.field">
        <field name="type_id" ref="element_type_mur"/>
        <field name="sequence">30</field>
        <field name="name">Hauteur</field>
        <field name="code">h</field>
        <field name="uom">m</field>
        <field name="required" eval="True"/>
    </record>
</odoo>
