<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_miro_mobile_device_tree" model="ir.ui.view">
        <field name="name">miro.mobile.device.tree</field>
        <field name="model">miro.mobile.device</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-muted="not active">
                <field name="user_id"/>
                <field name="name"/>
                <field name="last_seen"/>
                <field name="active" column_invisible="True"/>
                <button name="action_revoke" type="object" string="Révoquer" icon="fa-ban"
                        invisible="not active" confirm="Déconnecter ce téléphone ?"/>
            </tree>
        </field>
    </record>

    <record id="view_miro_mobile_device_search" model="ir.ui.view">
        <field name="name">miro.mobile.device.search</field>
        <field name="model">miro.mobile.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="name"/>
                <filter name="revoked" string="Révoqués" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_miro_mobile_device" model="ir.actions.act_window">
        <field name="name">Téléphones connectés</field>
        <field name="res_model">miro.mobile.device</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun téléphone connecté</p>
            <p>Un téléphone apparaît ici dès qu'un chef de chantier se connecte à
               l'application SuiviChantier.</p>
        </field>
    </record>

    <menuitem id="menu_miro_mobile_device" name="Téléphones connectés"
              parent="miro_construction_project.menu_construction_config"
              action="action_miro_mobile_device" sequence="80"
              groups="project.group_project_manager"/>
</odoo>
