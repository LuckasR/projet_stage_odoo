<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_miro_materiaux_managements" model="ir.module.category">
            <field name="name">miro materiaux managements</field>
            <field name="sequence">20</field>
        </record>

        <!-- Security Groups -->
        <record id="group_miro_materiaux_managements_user" model="res.groups">
            <field name="name">miro materiaux managements User</field>
            <field name="category_id" ref="module_category_miro_materiaux_managements"/>
        </record>

        <record id="group_miro_materiaux_managements_manager" model="res.groups">
            <field name="name">miro materiaux managements Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_miro_materiaux_managements_user'))]"/>
            <field name="category_id" ref="module_category_miro_materiaux_managements"/>
        </record>
    </data>
</odoo>
