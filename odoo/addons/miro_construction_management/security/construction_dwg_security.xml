<odoo>
    <record id="construction_dwg_files_project_rule" model="ir.rule">
        <field name="name">DWG Files: accès limité aux membres du projet</field>
        <field name="model_id" ref="model_construction_dwg_files"/>
        <field name="domain_force">
            [('project_id.user_id', '=', user.id)]
            <!-- ou selon votre logique, ex: membre de l'équipe -->
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>